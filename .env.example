# 环境变量示例。复制为 .env（不提交）或直接导出。
# dev profile 已内置可用默认值；生产环境必须显式提供。

# JWT 签名密钥（HS256，建议 >= 32 字节随机串）
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# api_key 等敏感字段的 AES-GCM 主密钥
AGENT_CRYPTO_KEY=dev-only-crypto-key-change-me-0123456789

# 可选：覆盖内网中间件连接（默认见 application-dev.yml）
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agent_platform
# SPRING_DATASOURCE_USERNAME=app_user
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=
# SPRING_DATA_REDIS_DATABASE=10
