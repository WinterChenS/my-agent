# 环境变量示例。复制为 .env（不提交）或直接导出。
# dev profile 已内置可用默认值；生产环境必须显式提供。

# JWT 签名密钥（HS256，建议 >= 32 字节随机串）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# api_key 等敏感字段的 AES-GCM 主密钥
AGENT_CRYPTO_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# 可选：覆盖内网中间件连接（默认见 application-dev.yml）
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agent_platform
# SPRING_DATASOURCE_USERNAME=app_user
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=
# SPRING_DATA_REDIS_DATABASE=10

# ===== Skill 从仓库导入的体积上限（可选）=====
# 安全默认：归档 20MB / 解压总量 64MB / 单文件 2MB / 条目 4000 / 单技能资源 300
# 实测 tt-a1i/archify 需要：归档 ≥51MB、解压总量 ≥95MB（技能目录内最大文件 0.97MB，单文件上限无需改）
# 仓库默认值已放宽为 64 / 128；想收回安全默认就在这里显式设小值。
# SKILL_IMPORT_MAX_ARCHIVE_MB=64
# SKILL_IMPORT_MAX_TOTAL_MB=128
# SKILL_IMPORT_MAX_FILE_KB=2048
# SKILL_IMPORT_MAX_ENTRIES=4000
# SKILL_IMPORT_MAX_RESOURCES=300
