# Comet / OpenSpec skill 运行时（本地安装产物，体积大，可由 `comet init` / `comet update` 重建）
.pi/skills/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<

# ===== Java / Maven =====
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.iml
*.log
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

