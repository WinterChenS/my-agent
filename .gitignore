# Comet / OpenSpec skill 运行时（本地安装产物，体积大，可由 `comet init` / `comet update` 重建）
.pi/skills/

# ===== Java / Maven =====
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.iml
*.log
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ===== Node / 前端 =====
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== IDE / 编辑器 =====
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.project
.classpath
.settings/

# ===== 本地机密与临时文件 =====
.env
.env.*
!.env.example

# ===== Agent 运行时工作区（HarnessAgent 产生的 memory / events，属于运行时状态） =====
.agentscope/
.myagent-workspace/

# ===== 验收产物的瞬时部分（截图保留，报告/trace 不入库） =====
docs/acceptance/playwright-report/
frontend/test-results/

# ===== Comet Runtime 的临时输入文件（不是交付物） =====
handoff.json
verifier.json
dispatch.json
ref.txt
acc.txt
.p10tmp-*/

# Comet 本地临时文件（handoff/verifier 输入与回执、临时脚本）
.comet-*
handoff-*.json
fill-handoff*.py
make-verifier-prompt*.py
patch-*.py
.p12-run.sse
.rr-*.json
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<

# 验证用的桩请求体 dump（临时产物）
.verify-dump.json
.t1-*.json

# 桩的请求 dump（测试产物，可能含会话内容，不入库）
tools/llm-stub/dump*.txt
e2e/.stub-started-by-tests

# 本地调试产物（logs/ 下的临时脚本与抓包）
/logs/
*.sse

# Docker 构建产物（由 scripts/build-artifacts.sh 生成，不入库）
deploy/artifacts/

# 浏览器 profile（本地跑浏览器工具时生成，含 cookie，绝不能进仓库）
**/.browser-profiles/
**/workspace/.reach-home/

# 扩展签名私钥（只保留公钥在 manifest 里，私钥永不提交）
browser-extension/.extension-key.pem
