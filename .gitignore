# Comet / OpenSpec skill 运行时（本地安装产物，体积大，可由 `comet init` / `comet update` 重建）
.pi/skills/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<

# ===== Java / Maven =====
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.iml
*.log
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ===== Node / 前端 =====
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== IDE / 编辑器 =====
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.project
.classpath
.settings/

# ===== 本地机密与临时文件 =====
.env
.env.*
!.env.example

# ===== Agent 运行时工作区（HarnessAgent 产生的 memory / events，属于运行时状态） =====
.agentscope/
.myagent-workspace/

# ===== 验收产物的瞬时部分（截图保留，报告/trace 不入库） =====
docs/acceptance/playwright-report/
frontend/test-results/

# ===== Comet Runtime 的临时输入文件（不是交付物） =====
handoff.json
verifier.json
dispatch.json
ref.txt
acc.txt
.p10tmp-*/

# Comet 本地临时文件（handoff/verifier 输入与回执、临时脚本）
