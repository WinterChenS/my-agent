# 生产部署用的环境变量模板 —— 复制成 .env 后填真实值（.env 不进版本库）
#
#   cp deploy/.env.example .env && vi .env
#
# 说明：数据库 / Redis / MinIO 都是**现有实例**，这里只写连接信息，不启动它们。

# ---------- PostgreSQL ----------
DB_URL=jdbc:postgresql://192.168.3.10:5432/agent_platform?stringtype=unspecified
DB_USERNAME=app_user
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=192.168.3.10
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=10

# ---------- MinIO（产物对象存储）----------
# ENDPOINT 是后端服务端访问用；PUBLIC_ENDPOINT 是浏览器下载用的（要能从用户网络访问到）
MINIO_ENDPOINT=http://192.168.3.225:19000
MINIO_PUBLIC_ENDPOINT=http://192.168.3.225:19000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=agent-platform
MINIO_MAX_FILE_MB=50

# ---------- 应用密钥（生产必须换成随机值，且与旧环境保持一致才能解开库里已加密的数据）----------
# JWT_SECRET 至少 32 字节随机串；AGENT_CRYPTO_KEY 用于加密供应商 API Key
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
AGENT_CRYPTO_KEY=change-me-crypto-key

# ---------- 上传上限（nginx 60MB / 容器 55MB 与之配套）----------
MYAGENT_MULTIPART_MAX_FILE=55MB
MYAGENT_MULTIPART_MAX_REQUEST=60MB

# ---------- 技能导入体积限制 ----------
SKILL_IMPORT_MAX_ARCHIVE_MB=64
SKILL_IMPORT_MAX_TOTAL_MB=128

# ---------- 可选：模型重试 / 上下文压缩（不填用 application.yml 默认值）----------
# MYAGENT_MODEL_MAX_RETRIES=3
# MYAGENT_COMPACTION_TRIGGER_RATIO=0.9
# MYAGENT_AGENT_DEFAULT_MAX_ITER=100
